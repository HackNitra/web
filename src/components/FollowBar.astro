---
import { partnerMailto, socials } from '../data/site';

interface Props {
  /** Pinned to the bottom of the viewport; otherwise a plain footer. */
  fixed?: boolean;
}

const { fixed = true } = Astro.props;
const privacyPath = '/sukromie/';
const onPrivacy = Astro.url.pathname.replace(/\/?$/, '/') === privacyPath;
---

<footer class:list={['follow-bar', { fixed }]}>
  <div class="wrap">
    <div class="follow">
      <span class="txt">Sleduj @hacknitra</span>
      <span class="social">
        {
          socials.map((social) => (
            <a href={social.href} aria-label={social.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                {social.icon === 'facebook' && (
                  <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z" />
                )}
                {social.icon === 'instagram' && (
                  <Fragment>
                    <rect fill="none" stroke="currentColor" stroke-width="2" x="3" y="3" width="18" height="18" rx="5" />
                    <circle fill="none" stroke="currentColor" stroke-width="2" cx="12" cy="12" r="4.2" />
                    <circle cx="17.3" cy="6.7" r="1.3" />
                  </Fragment>
                )}
                {social.icon === 'linkedin' && (
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                )}
              </svg>
            </a>
          ))
        }
      </span>
      {/* Phones get the short label; the accessible name always carries both. */}
      <a
        class="legal"
        href={privacyPath}
        aria-label="Ochrana osobných údajov (GDPR)"
        aria-current={onPrivacy ? 'page' : undefined}
      >
        <span class="long">Ochrana osobných údajov</span><span class="short">GDPR</span>
      </a>
    </div>
    <slot>
      <a class="btn" href={partnerMailto}>Staň sa partnerom</a>
    </slot>
  </div>
</footer>
